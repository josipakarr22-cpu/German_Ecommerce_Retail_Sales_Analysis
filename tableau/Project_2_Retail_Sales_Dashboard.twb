    <worksheet name='Sheet 1'>
      <table>
        <view>
          <datasources>
            <datasource caption='CLEAN_DATA (JOCO_Project_2_Retail_Sales_Dataset)' name='federated.0u2emn719hks1l14f7dgp1jkfh2o' />
          </datasources>
          <datasource-dependencies datasource='federated.0u2emn719hks1l14f7dgp1jkfh2o'>
            <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_1124023645249536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
            </column>
            <column caption='Category Clean' datatype='string' name='[Calculation_1124023956131841]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LOWER([Category]) = &quot;office supplies&quot; THEN &quot;Office Supplies&quot;&#13;&#10;ELSE [Category]&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='real' name='[Discount]' role='measure' type='quantitative' />
            <column datatype='real' name='[F19]' role='measure' type='quantitative' />
            <column datatype='integer' name='[F21]' role='measure' type='quantitative' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' default-format='C1031%' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column datatype='real' default-format='C1031%' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
